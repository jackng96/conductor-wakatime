{
  "name": "conductor-wakatime",
  "version": "0.1.0",
  "description": "WakaTime tracking for Conductor agent sessions.",
  "homepage": "https://github.com/jackng96/conductor-wakatime#readme",
  "bugs": {
    "url": "https://github.com/jackng96/conductor-wakatime/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackng96/conductor-wakatime.git"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "conductor-wakatime": "./bin/conductor-wakatime.js"
  },
  "type": "commonjs",
  "scripts": {
    "setup": "node ./bin/conductor-wakatime.js setup",
    "install:agent": "node ./bin/conductor-wakatime.js install",
    "uninstall:agent": "node ./bin/conductor-wakatime.js uninstall",
    "status": "node ./bin/conductor-wakatime.js status",
    "doctor": "node ./bin/conductor-wakatime.js doctor",
    "track:once": "node ./bin/conductor-wakatime.js track-once",
    "test:heartbeat": "node ./bin/conductor-wakatime.js test-heartbeat",
    "pack:dry-run": "npm pack --dry-run",
    "test": "node --test"
  },
  "keywords": [
    "conductor",
    "wakatime",
    "codex",
    "claude"
  ],
  "license": "MIT"
}
